<div class="card">
  <h1>로그인</h1>

  <p class="muted">Bio-Pass 이메일·전화(앱) 인증으로 로그인합니다. (scope: email, phone)</p>
  <form method="get" action="/auth/biopass" class="form">
    <label>
      이메일
      <input
        type="email"
        name="email"
        autocomplete="email"
        placeholder="user@example.com"
        required
        autofocus
      >
    </label>
    <label>
      전화번호 <span class="label-optional">(선택, 앱·SMS 인증 시)</span>
      <input type="tel" name="phone" autocomplete="tel" placeholder="+821012345678">
    </label>
    <button type="submit" class="btn primary btn-block">Bio-Pass로 로그인</button>
  </form>
  <% if (typeof bioPassSecretMisconfigured !== "undefined" && bioPassSecretMisconfigured) { %>
    <p class="muted warn-hint">
      <code>BIO_PASS_CLIENT_SECRET</code>에 Client ID가 들어가 있습니다.
      bio-pass 앱 상세의 <strong>Client Secret</strong>(<code>secret_</code>로 시작)을
      아래 오버라이드 폼 또는 <code>.env</code>에 넣으세요.
    </p>
  <% } else if (typeof bioPassConfigured !== "undefined" && !bioPassConfigured) { %>
    <p class="muted warn-hint">
      연동 미완료: 아래 오버라이드 폼 또는 <code>.env</code>에
      <code>BIO_PASS_CLIENT_ID</code>, <code>BIO_PASS_CLIENT_SECRET</code>을 설정하세요.
    </p>
  <% } %>

  <div class="login-divider" role="separator"><span>또는</span></div>
  <p class="muted muted-tight">로컬 데모 계정: <strong>admin</strong> / <strong>admin</strong></p>

  <form method="post" action="/login" class="form">
    <label>
      아이디
      <input type="text" name="username" autocomplete="username" required>
    </label>
    <label>
      비밀번호
      <input type="password" name="password" autocomplete="current-password" required>
    </label>
    <button type="submit" class="btn">로컬 계정으로 로그인</button>
  </form>

  <% if (typeof updateStatus !== "undefined" && updateStatus) { %>
    <section class="update-section">
      <h2 class="subsection-title">자동 업데이트</h2>
      <p class="muted section-desc">
        원격 저장소에서 <code>git pull</code> 후 서버를 재시작합니다.
        <% if (updateStatus.restartWrapper) { %>
          <span class="inline-note">(<code>npm start</code> 재시작 래퍼 활성)</span>
        <% } else { %>
          <span class="warn-hint inline-note"><code>npm start</code> 사용을 권장합니다.</span>
        <% } %>
      </p>

      <% if (updateStatus.isRepo) { %>
        <p class="muted update-meta">
          <code><%= updateStatus.branch || "—" %></code>
          @ <code><%= updateStatus.commit || "—" %></code>
          <% if (updateStatus.hasUpstream) { %>
            · behind <code><%= updateStatus.behind %></code>
          <% } %>
        </p>
      <% } %>
      <% if (updateStatus.message) { %>
        <p class="muted update-meta"><%= updateStatus.message %></p>
      <% } %>

      <form method="post" action="/update" class="form update-form">
        <% if (typeof updateSecretRequired !== "undefined" && updateSecretRequired) { %>
          <label>
            UPDATE_SECRET
            <input type="password" name="updateSecret" autocomplete="off" required>
          </label>
        <% } %>
        <button
          type="submit"
          class="btn primary btn-block"
          <%= updateStatus.canPull ? "" : "disabled" %>
        >
          최신으로 업데이트
        </button>
      </form>
    </section>
  <% } %>

  <% if (typeof bioPassOverrideFields !== "undefined" && bioPassOverrideFields.length) { %>
    <section class="env-section">
      <h2 class="subsection-title">Bio-Pass 설정 오버라이드</h2>
      <p class="muted section-desc">
        아래 값을 바꾸면 이 브라우저 세션에서만 <code>.env</code>보다 우선 적용됩니다.
        서버 재시작 없이 바로 로그인에 반영됩니다.
        <% if (typeof bioPassHasOverrides !== "undefined" && bioPassHasOverrides) { %>
          <span class="warn-hint inline-note">현재 세션 오버라이드 적용 중</span>
        <% } %>
      </p>
      <form method="post" action="/settings/biopass" class="form override-form">
        <% bioPassOverrideFields.forEach(function (field) { %>
          <label>
            <code><%= field.label %></code>
            <% if (field.overridden) { %>
              <span class="badge">오버라이드</span>
            <% } %>
            <input
              type="<%= field.key === 'clientSecret' ? 'password' : 'text' %>"
              name="<%= field.key %>"
              value="<%= field.value %>"
              autocomplete="off"
              spellcheck="false"
              placeholder="<%= field.envDefault || '(미설정)' %>"
            >
          </label>
        <% }) %>
        <div class="form-actions">
          <button type="submit" class="btn primary">적용</button>
          <button type="submit" class="btn" formaction="/settings/biopass/reset" formmethod="post">
            .env로 초기화
          </button>
        </div>
      </form>
    </section>
  <% } %>

  <% if (typeof envRows !== "undefined" && envRows.length) { %>
    <section class="env-section">
      <h2 class="subsection-title">현재 환경 변수</h2>
      <p class="muted section-desc">
        서버가 실제로 사용하는 값입니다. Bio-Pass 항목은 세션 오버라이드가 있으면 반영됩니다.
      </p>
      <table class="kv-table kv-table-spaced">
        <thead>
          <tr>
            <th>변수</th>
            <th>값</th>
          </tr>
        </thead>
        <tbody>
          <% envRows.forEach(function (row) { %>
            <tr>
              <th><code><%= row.key %></code></th>
              <td>
                <code class="break-all"><%= row.value %></code>
                <% if (row.note) { %>
                  <span class="muted inline-note">(<%= row.note %>)</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  <% } %>
</div>
