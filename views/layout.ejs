<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== "undefined" ? title : "로그인" %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="page">
    <% if (flashSuccess && flashSuccess.length) { %>
      <ul class="flash-list">
        <% flashSuccess.forEach(function (msg) { %>
          <li class="flash flash-success"><%= msg %></li>
        <% }) %>
      </ul>
    <% } %>
    <% if (flashError && flashError.length) { %>
      <ul class="flash-list">
        <% flashError.forEach(function (msg) { %>
          <li class="flash flash-error"><%= msg %></li>
        <% }) %>
      </ul>
    <% } %>
    <%- body %>
  </div>
</body>
</html>
