<div class="card wide">
  <header class="dash-header">
    <div>
      <h1>안녕하세요, <%= username %></h1>
      <p class="muted">
        SQLite에 저장된 로그인 기록입니다.
        <% if (typeof authProvider !== "undefined" && authProvider === "biopass") { %>
          <span class="badge">Bio-Pass</span>
        <% } %>
      </p>
    </div>
    <form method="post" action="/logout">
      <button type="submit" class="btn">로그아웃</button>
    </form>
  </header>

  <% if (typeof bioPassAuthResult !== "undefined" && bioPassAuthResult) { %>
    <section class="log-section">
      <h2>POST /web/token <span class="badge">토큰 교환</span></h2>
      <p class="muted section-desc">authorization code를 access_token · refresh_token으로 교환합니다.</p>

      <h3 class="subsection-title">요청 Body</h3>
      <table class="kv-table">
        <tbody>
          <tr><th>endpoint</th><td><code class="break-all"><%= bioPassAuthResult.tokenRequest.endpoint %></code></td></tr>
          <tr><th>Content-Type</th><td><%= bioPassAuthResult.tokenRequest.contentType %></td></tr>
          <tr><th>grant_type</th><td><code><%= bioPassAuthResult.tokenRequest.body.grant_type %></code></td></tr>
          <tr><th>code</th><td><code class="break-all"><%= bioPassAuthResult.tokenRequest.body.code %></code> <span class="muted inline-note">(마스킹)</span></td></tr>
          <tr><th>client_id</th><td><code class="break-all"><%= bioPassAuthResult.tokenRequest.body.client_id %></code></td></tr>
          <tr><th>client_secret</th><td><code><%= bioPassAuthResult.tokenRequest.body.client_secret %></code> <span class="muted inline-note">(마스킹)</span></td></tr>
          <tr><th>redirect_uri</th><td><code class="break-all"><%= bioPassAuthResult.tokenRequest.body.redirect_uri %></code></td></tr>
        </tbody>
      </table>

      <h3 class="subsection-title">응답 (200)</h3>
      <table class="kv-table">
        <tbody>
          <tr><th>access_token</th><td><code><%= bioPassAuthResult.tokenResponse.access_token %></code> <span class="muted inline-note">(마스킹)</span></td></tr>
          <tr><th>token_type</th><td><code><%= bioPassAuthResult.tokenResponse.token_type %></code></td></tr>
          <tr><th>expires_in</th><td><%= bioPassAuthResult.tokenResponse.expires_in != null ? bioPassAuthResult.tokenResponse.expires_in + " (초)" : "null" %></td></tr>
          <tr><th>refresh_token</th><td>
            <% if (bioPassAuthResult.tokenResponse.refresh_token) { %>
              <code><%= bioPassAuthResult.tokenResponse.refresh_token %></code> <span class="muted inline-note">(마스킹)</span>
            <% } else { %>
              <code class="null-value">null</code>
            <% } %>
          </td></tr>
          <tr><th>scope</th><td><code><%= bioPassAuthResult.tokenResponse.scope != null ? bioPassAuthResult.tokenResponse.scope : "null" %></code></td></tr>
        </tbody>
      </table>
    </section>

    <section class="log-section">
      <h2>POST /web/verify-token <span class="badge">client_secret 포함</span></h2>
      <p class="muted section-desc">access_token과 client_id · client_secret으로 사용자 정보를 조회합니다.</p>

      <h3 class="subsection-title">요청 Body</h3>
      <table class="kv-table">
        <tbody>
          <tr><th>endpoint</th><td><code class="break-all"><%= bioPassAuthResult.verifyRequest.endpoint %></code></td></tr>
          <tr><th>Content-Type</th><td><%= bioPassAuthResult.verifyRequest.contentType %></td></tr>
          <tr><th>token</th><td><code><%= bioPassAuthResult.verifyRequest.body.token %></code> <span class="muted inline-note">(access_token, 마스킹)</span></td></tr>
          <tr><th>client_id</th><td><code class="break-all"><%= bioPassAuthResult.verifyRequest.body.client_id %></code></td></tr>
          <tr><th>client_secret</th><td><code><%= bioPassAuthResult.verifyRequest.body.client_secret %></code> <span class="muted inline-note">(마스킹)</span></td></tr>
        </tbody>
      </table>

      <h3 class="subsection-title">응답 (200)</h3>
      <table class="kv-table">
        <tbody>
          <tr><th>success</th><td><code><%= bioPassAuthResult.verifyResponse.success %></code></td></tr>
          <tr><th>authenticated</th><td><code><%= bioPassAuthResult.verifyResponse.authenticated %></code></td></tr>
        </tbody>
      </table>

      <h3 class="subsection-title">user <span class="muted inline-note">(resolveVerifiedUser)</span></h3>
      <% if (verifyUserRows && verifyUserRows.length) { %>
        <table class="kv-table kv-table-spaced">
          <thead>
            <tr>
              <th>필드</th>
              <th>값</th>
            </tr>
          </thead>
          <tbody>
            <% verifyUserRows.forEach(function (row) { %>
              <tr>
                <th><code>user.<%= row.apiKey %></code><br><span class="field-label-ko"><%= row.label %></span></th>
                <td>
                  <% if (row.isNull) { %>
                    <code class="null-value">null</code>
                  <% } else if (row.isCode) { %>
                    <code class="break-all"><%= row.displayValue %></code>
                  <% } else { %>
                    <%= row.displayValue %>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <p class="muted">user 객체가 비어 있습니다.</p>
      <% } %>
    </section>
  <% } %>

  <% if (typeof showUpdatePanel !== "undefined" && showUpdatePanel && updateStatus) { %>
    <section class="log-section update-section">
      <h2>자동 업데이트 <span class="badge">git pull</span></h2>
      <p class="muted section-desc">
        원격 저장소에서 최신 코드를 받은 뒤 서버 프로세스를 종료하고 다시 시작합니다.
        <% if (updateStatus.restartWrapper) { %>
          <span class="inline-note">(재시작 래퍼 활성 — <code>npm start</code>)</span>
        <% } else { %>
          <span class="warn-hint inline-note">재시작 래퍼 없음 — <code>npm start</code> 사용을 권장합니다.</span>
        <% } %>
      </p>

      <table class="kv-table kv-table-spaced">
        <tbody>
          <tr>
            <th>상태</th>
            <td><%= updateStatus.enabled ? "활성" : "비활성" %></td>
          </tr>
          <% if (updateStatus.isRepo) { %>
            <tr>
              <th>브랜치</th>
              <td><code><%= updateStatus.branch || "—" %></code></td>
            </tr>
            <tr>
              <th>현재 커밋</th>
              <td>
                <code><%= updateStatus.commit || "—" %></code>
                <% if (updateStatus.commitSubject) { %>
                  <span class="muted inline-note"><%= updateStatus.commitSubject %></span>
                <% } %>
              </td>
            </tr>
            <tr>
              <th>원격 대비</th>
              <td>
                <% if (updateStatus.hasUpstream) { %>
                  behind <code><%= updateStatus.behind %></code>,
                  ahead <code><%= updateStatus.ahead %></code>
                <% } else { %>
                  upstream 미설정
                <% } %>
              </td>
            </tr>
            <tr>
              <th>작업 트리</th>
              <td><%= updateStatus.dirty ? "로컬 변경 있음" : "깨끗함" %></td>
            </tr>
          <% } %>
          <% if (updateStatus.message) { %>
            <tr>
              <th>안내</th>
              <td><%= updateStatus.message %></td>
            </tr>
          <% } %>
        </tbody>
      </table>

      <form method="post" action="/admin/update" class="form update-form">
        <% if (typeof updateSecretRequired !== "undefined" && updateSecretRequired) { %>
          <label>
            UPDATE_SECRET
            <input type="password" name="updateSecret" autocomplete="off" required>
          </label>
        <% } %>
        <button
          type="submit"
          class="btn primary"
          <%= updateStatus.canUpdate ? "" : "disabled" %>
        >
          git pull 후 재시작
        </button>
      </form>
    </section>
  <% } %>

  <section class="log-section">
    <h2>로그인 기록</h2>
    <% if (logs && logs.length) { %>
      <table class="log-table">
        <thead>
          <tr>
            <th>#</th>
            <th>로그인 시각 (UTC)</th>
            <th>IP</th>
          </tr>
        </thead>
        <tbody>
          <% logs.forEach(function (row, i) { %>
            <tr>
              <td><%= i + 1 %></td>
              <td><code><%= row.logged_in_at %></code></td>
              <td><%= row.ip_address ? row.ip_address : "—" %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <p class="muted">아직 기록이 없습니다. 다시 로그인하면 여기에 표시됩니다.</p>
    <% } %>
  </section>
</div>
