# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 수정하세요.
# Copy this file to `.env` and adjust values.

# HTTP 포트 (미설정 시 기본 5000)
PORT=5000

# 세션 암호화용 비밀키. 프로덕션에서는 긴 무작위 문자열로 반드시 변경하세요.
# Windows PowerShell 예: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | % {[char]$_})
SECRET_KEY=dev-change-me-in-production

# --- Bio-Pass 연동 (bio-pass 콘솔에서 앱 client_id / secret / callback URL 등록) ---
# API 베이스 (trailing slash 없음). 로컬 bio-pass 백엔드 예: http://127.0.0.1:3030/api
BIO_PASS_API=http://127.0.0.1:3030/api

# 애플리케이션 Client ID / Secret (bio-pass 관리 화면)
BIO_PASS_CLIENT_ID=app_aa23d41dd580c248fa0f2d570d7134c7
BIO_PASS_CLIENT_SECRET=app_aa23d41dd580c248fa0f2d570d7134c7

# bio-pass 앱에 등록한 callback URL과 동일해야 함 (이 서버의 /auth/callback)
BIO_PASS_REDIRECT_URI=http://127.0.0.1:5000/auth/callback

# authorize scope: email | phone | email,phone
BIO_PASS_SCOPE=email
